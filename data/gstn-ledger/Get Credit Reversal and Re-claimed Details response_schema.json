    "gstin": {
      "maxLength": 15,
      "minLength": 15,
      "pattern": "[0-9]{2}[a-zA-Z]{5}[0-9]{4}[a-zA-Z]{1}[1-9A-Za-z]{1}[Zz1-9A-Ja-j]{1}[0-9a-zA-Z]{1}",
      "type": "string"
    },
    "taxamt": {
      "type": "number",
      "multipleOf": 0.01,
      "maximum": 9999999999999.99,
      "minimum": -9999999999999.99
    },
    "ret_period": {
      "pattern": "^((0[1-9]|1[012])((19|20)\\d\\d))$",
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^(0[1-9]|[12][0-9]|3[01])[/](0[1-9]|1[012])[/](19|20)\\d\\d$"
