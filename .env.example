# ---------------------------------------------------------------------------
# Khata backend configuration.
#
# Copy to `.env.development` for local work. Every variable here is validated
# by src/config/env.ts at boot — a missing or malformed value stops the
# process rather than surfacing as a confusing runtime failure later.
#
# NOTHING IN THIS FILE IS A REAL SECRET. Production values are injected by the
# deployment platform; no .env file should ever exist on a production host.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# APP_ENV drives behaviour (auth bypass, seeds, log format). It is deliberately
# separate from NODE_ENV, which stays "production" in any built image so
# Express and the dependency tree take their optimised paths.
APP_ENV=development
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public base URL of this API. Used in OpenAPI servers and receipt QR targets.
PUBLIC_BASE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Local: the docker-compose Postgres.
# Production: the Supabase *pooler* connection string (port 6543, pgbouncer in
# transaction mode), using the dedicated `app_user` role — never `postgres`,
# which has BYPASSRLS and would silently disable every tenant policy.
# Port 5433: the docker-compose Postgres deliberately avoids 5432 so it does
# not collide with a PostgreSQL installed directly on the host.
DATABASE_URL=postgresql://khata:khata@localhost:5433/khata
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Redis -----------------------------------------------------------------
# Backs rate limiting, the cache, OTP storage and idempotency keys.
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
# Must be at least 32 bytes. Boot fails if a known placeholder is used with
# APP_ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
JWT_ISSUER=khata-api
JWT_AUDIENCE=khata-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# --- OTP / SMS -------------------------------------------------------------
# SMS_PROVIDER=console logs the OTP instead of sending it. Refused in production.
SMS_PROVIDER=console
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# DEVELOPMENT ONLY. Both are rejected at boot when APP_ENV=production.
#   AUTH_DEV_BYPASS=true   enables POST /v1/auth/dev-login (instant token pair)
#   AUTH_DEV_FIXED_OTP     an OTP accepted for any phone number
AUTH_DEV_BYPASS=true
AUTH_DEV_FIXED_OTP=000000

# --- HTTP ------------------------------------------------------------------
# Comma-separated exact origins. "*" is refused in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
BODY_LIMIT=1mb

# Number of proxy hops in front of this process, for correct client IPs in
# rate limiting. 0 = no proxy; 1 = one load balancer.
TRUST_PROXY_HOPS=0

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_HOUR=20
RATE_LIMIT_SYNC_PER_MINUTE=120

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true
DOCS_ENABLED=true
METRICS_ENABLED=true
