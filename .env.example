# Every variable is required unless marked (optional).
# Copy to .env.development and fill in values; src/config/env.ts refuses to
# start on any gap. Production injects variables directly, with no file.
# Comments sit above each key: inline "#" is not stripped by every Node
# --env-file parser and would become part of the value.

# ===== Runtime =====
# development | production
APP_ENV=
# development | test | production
NODE_ENV=
# Appears in logs, metrics and /healthz
SERVICE_NAME=
HOST=
PORT=
# Externally reachable URL of this API
PUBLIC_BASE_URL=

# ===== Database (Supabase) =====
# Transaction-mode pooler URL connecting as DATABASE_APP_ROLE_NAME.
# Supavisor usernames have the form <role>.<project-ref>.
DATABASE_URL=
# (optional) Session-mode pooler or direct URL as the `postgres` owner role.
# Read only by `migrate` and `db:bootstrap`, never by the running API.
DATABASE_MIGRATION_URL=
# Login role the API uses; created by db:bootstrap
DATABASE_APP_ROLE_NAME=
# (optional) Read only by db:bootstrap
DATABASE_APP_ROLE_PASSWORD=
# true | false
DATABASE_SSL=
# true | false. Must be true in production (Supavisor's chain is not trusted
# by Node, so production also needs DATABASE_SSL_CA).
DATABASE_SSL_REJECT_UNAUTHORIZED=
# (optional) PEM of the CA that signs the pooler certificate; newlines may be
# written as the two characters \n. Download it from the Supabase dashboard.
DATABASE_SSL_CA=
# Connections per API instance; the pooler's client limit is shared by all instances
DATABASE_POOL_MAX=
DATABASE_POOL_IDLE_TIMEOUT_MS=
DATABASE_CONNECTION_TIMEOUT_MS=
DATABASE_STATEMENT_TIMEOUT_MS=
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=
# Retries on serialization failure / deadlock
DATABASE_TRANSACTION_MAX_RETRIES=
DATABASE_RETRY_BASE_DELAY_MS=

# ===== Object storage (Supabase Storage) =====
# The bucket must be PRIVATE. Clients never see this key: the API hands out
# short-lived signed URLs and the client uploads straight to Supabase, so no
# file byte transits the API.
SUPABASE_URL=
# service_role key, from the Supabase project's API settings. Secret.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Keep both short: a signed URL is a bearer credential on the bucket
STORAGE_UPLOAD_URL_TTL_SECONDS=
STORAGE_DOWNLOAD_URL_TTL_SECONDS=
STORAGE_MAX_UPLOAD_BYTES=
STORAGE_REQUEST_TIMEOUT_MS=

# ===== Bulk import =====
# Ingest reads the spreadsheet once; analyse and apply advance in chunks, so
# the chunk sizes bound one request's work, not the size of an import.
IMPORT_MAX_ROWS=
IMPORT_ANALYSE_CHUNK_ROWS=
IMPORT_APPLY_CHUNK_ROWS=
# Hours without progress after which a job is abandoned and its upload purged
IMPORT_JOB_TTL_HOURS=

# ===== Redis =====
REDIS_URL=
REDIS_KEY_PREFIX=
REDIS_CONNECT_TIMEOUT_MS=
REDIS_COMMAND_TIMEOUT_MS=
REDIS_MAX_RETRIES_PER_REQUEST=
REDIS_RECONNECT_STEP_MS=
REDIS_RECONNECT_MAX_DELAY_MS=
# Read only by docker-compose (npm run infra:up)
REDIS_IMAGE_TAG=
REDIS_MAXMEMORY=
REDIS_MAXMEMORY_POLICY=
REDIS_HOST_PORT=

# ===== Tokens =====
# At least 32 characters, e.g. openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
ACCESS_TOKEN_TTL_SECONDS=
# Lifetime of the token issued after OTP, before a tenant is chosen
IDENTITY_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_DAYS=
REFRESH_TOKEN_BYTES=
# Window in which a client re-sending an already-rotated refresh token is
# treated as a network retry rather than token theft
REFRESH_TOKEN_REUSE_GRACE_SECONDS=

# ===== OTP / SMS =====
# At least 32 characters and different from JWT_SECRET
OTP_HASH_SECRET=
OTP_LENGTH=
OTP_TTL_SECONDS=
OTP_MAX_ATTEMPTS=
OTP_RESEND_COOLDOWN_SECONDS=
# Digits only, no "+"
PHONE_DEFAULT_COUNTRY_CODE=
# Digits in a national number without the country code
PHONE_NATIONAL_NUMBER_LENGTH=

# ===== OTP delivery =====
# Who carries the code to the person. console | fake | twilio | msg91.
# console logs the code and fake records it for tests; both are refused in
# production. Each real provider has its own keys below, and boot fails if the
# selected provider is missing any of them. To add a vendor see
# docs/ADDING_A_DELIVERY_PROVIDER.md.
OTP_DELIVERY_PROVIDER=
# Per-request timeout for the provider's HTTP call
OTP_DELIVERY_TIMEOUT_MS=

# (optional) Twilio — all five required when OTP_DELIVERY_PROVIDER=twilio
TWILIO_API_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number in E.164 with "+", or an alphanumeric sender id
TWILIO_SENDER_ID=
# Message body; must contain {code}, may contain {minutes}
TWILIO_OTP_MESSAGE_TEMPLATE=

# (optional) MSG91 — all three required when OTP_DELIVERY_PROVIDER=msg91
MSG91_API_BASE_URL=
MSG91_AUTH_KEY=
# DLT-approved OTP template id
MSG91_TEMPLATE_ID=

# DEVELOPMENT ONLY. Boot is refused in production if either is enabled.
# true mounts POST /v1/auth/dev-login
AUTH_DEV_BYPASS=
# (optional) OTP_LENGTH digits accepted for any phone number
AUTH_DEV_FIXED_OTP=

# ===== HTTP =====
# Comma-separated exact origins
CORS_ALLOWED_ORIGINS=
CORS_MAX_AGE_SECONDS=
# Size string accepted by express.json
BODY_LIMIT=
# Number of proxies in front of the API; 0 when none
TRUST_PROXY_HOPS=
COMPRESSION_THRESHOLD_BYTES=
HSTS_MAX_AGE_SECONDS=
# Must exceed the load balancer's idle timeout
HTTP_KEEP_ALIVE_TIMEOUT_MS=
# Must exceed HTTP_KEEP_ALIVE_TIMEOUT_MS
HTTP_HEADERS_TIMEOUT_MS=
SHUTDOWN_TIMEOUT_MS=

# ===== Rate limiting =====
RATE_LIMIT_API_POINTS=
RATE_LIMIT_API_WINDOW_SECONDS=
RATE_LIMIT_OTP_REQUEST_POINTS=
RATE_LIMIT_OTP_REQUEST_WINDOW_SECONDS=
RATE_LIMIT_OTP_VERIFY_POINTS=
RATE_LIMIT_OTP_VERIFY_WINDOW_SECONDS=
RATE_LIMIT_REFRESH_POINTS=
RATE_LIMIT_REFRESH_WINDOW_SECONDS=
# Per device, on /sync/* and number-block leases
RATE_LIMIT_SYNC_POINTS=
RATE_LIMIT_SYNC_WINDOW_SECONDS=
# Per tenant, on POST /v1/uploads/sign. Its own budget because each signed URL
# is a writable handle on the bucket.
RATE_LIMIT_UPLOAD_SIGN_POINTS=
RATE_LIMIT_UPLOAD_SIGN_WINDOW_SECONDS=

# ===== Sync =====
# Rows per pull page
SYNC_PULL_MAX_CHANGES=
# Operations accepted in one push batch
SYNC_PUSH_MAX_OPERATIONS=
# A pull leases a fresh block when a device has fewer numbers left than this
SYNC_LEASE_TOPUP_THRESHOLD=
# Days before FY end at which next year's series are created and pre-leased
SYNC_FY_ROLLOVER_LEAD_DAYS=

# ===== Pagination =====
PAGE_SIZE_DEFAULT=
PAGE_SIZE_MAX=

# ===== GST / document numbering =====
# Comma-separated GST percentages currently notified
GST_ALLOWED_RATES=
# Maximum document number length under GST rule 46(b)
DOCUMENT_NUMBER_MAX_LENGTH=
# Smallest sequence ceiling a series format is allowed to have
DOCUMENT_SEQUENCE_MIN_HEADROOM=
NUMBER_BLOCK_SIZE_DEFAULT=
NUMBER_BLOCK_SIZE_MAX=
NUMBER_BLOCK_TTL_HOURS=

# ===== Reports =====
# (optional) Comma-separated report ids available on the free plan; every
# other report requires the reports.all feature
PLAN_FREE_REPORT_IDS=
# Widest window a single report may cover
REPORT_MAX_RANGE_DAYS=
REPORT_MAX_ROWS=

# ===== Counter operations =====
# Parked bills allowed per counter
HELD_BILL_MAX_PER_COUNTER=
# Cash-up difference in paise above which the close is flagged
DAY_CLOSE_VARIANCE_WARN_PAISE=

# ===== Tenant onboarding defaults (used when the client omits a value) =====
TENANT_DEFAULT_LOCALE=
# IANA timezone
TENANT_DEFAULT_TIMEZONE=
# ISO 4217
TENANT_DEFAULT_CURRENCY_CODE=
TENANT_DEFAULT_CURRENCY_SYMBOL=
# 1-12
TENANT_DEFAULT_FY_START_MONTH=
TENANT_DEFAULT_ALLOW_NEGATIVE_STOCK=
TENANT_DEFAULT_PRICES_INCLUDE_TAX=

# ===== Free plan limits (each optional; unset means unlimited) =====
PLAN_FREE_MAX_USERS=
PLAN_FREE_MAX_OUTLETS=
PLAN_FREE_MAX_COUNTERS=
PLAN_FREE_MAX_ITEMS=
# (optional) Comma-separated feature keys granted on the free plan; unset
# grants none. "*" grants everything, "group.*" everything in one group.
PLAN_FREE_FEATURES=

# ===== OpenAPI =====
# true serves GET /v1/openapi.json and Swagger UI at /v1/docs without auth
OPENAPI_ENABLED=
OPENAPI_TITLE=
# Base URL printed in the document's servers list, usually PUBLIC_BASE_URL
OPENAPI_SERVER_URL=

# ===== Observability =====
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=
# Must be false in production
LOG_PRETTY=
METRICS_ENABLED=
METRICS_PREFIX=
# Comma-separated histogram buckets in seconds
METRICS_LATENCY_BUCKETS_SECONDS=
