{
  "contract": "numbering",
  "version": 1,
  "notes": [
    "Generated by `npm run contracts:generate` from src/domain/numbering/series.ts; do not edit by hand.",
    "Dates are calendar strings (YYYY-MM-DD); instants are ISO-8601 UTC strings.",
    "A financial year in an input is given as {date, fyStartMonth} and must be resolved with financialYearOf first.",
    "validateSeriesFormat returns null on success; nextInBlock returns null when the block is spent or expired.",
    "expected.error means the reference rejected the input with that error code; a port must reject too."
  ],
  "cases": [
    {
      "name": "April-start FY in June",
      "op": "financialYearOf",
      "input": {
        "date": "2026-06-15",
        "fyStartMonth": 4
      },
      "expected": {
        "result": {
          "startYear": 2026,
          "label": "2026-27",
          "shortLabel": "26-27",
          "startDate": "2026-04-01",
          "endDate": "2027-03-31"
        }
      }
    },
    {
      "name": "last day before FY start",
      "op": "financialYearOf",
      "input": {
        "date": "2026-03-31",
        "fyStartMonth": 4
      },
      "expected": {
        "result": {
          "startYear": 2025,
          "label": "2025-26",
          "shortLabel": "25-26",
          "startDate": "2025-04-01",
          "endDate": "2026-03-31"
        }
      }
    },
    {
      "name": "first day of FY",
      "op": "financialYearOf",
      "input": {
        "date": "2026-04-01",
        "fyStartMonth": 4
      },
      "expected": {
        "result": {
          "startYear": 2026,
          "label": "2026-27",
          "shortLabel": "26-27",
          "startDate": "2026-04-01",
          "endDate": "2027-03-31"
        }
      }
    },
    {
      "name": "March-start FY with leap year end",
      "op": "financialYearOf",
      "input": {
        "date": "2023-05-01",
        "fyStartMonth": 3
      },
      "expected": {
        "result": {
          "startYear": 2023,
          "label": "2023-24",
          "shortLabel": "23-24",
          "startDate": "2023-03-01",
          "endDate": "2024-02-29"
        }
      }
    },
    {
      "name": "March-start FY with non-leap end",
      "op": "financialYearOf",
      "input": {
        "date": "2024-05-01",
        "fyStartMonth": 3
      },
      "expected": {
        "result": {
          "startYear": 2024,
          "label": "2024-25",
          "shortLabel": "24-25",
          "startDate": "2024-03-01",
          "endDate": "2025-02-28"
        }
      }
    },
    {
      "name": "calendar-year FY",
      "op": "financialYearOf",
      "input": {
        "date": "2026-06-15",
        "fyStartMonth": 1
      },
      "expected": {
        "result": {
          "startYear": 2026,
          "label": "2026-27",
          "shortLabel": "26-27",
          "startDate": "2026-01-01",
          "endDate": "2026-12-31"
        }
      }
    },
    {
      "name": "December-start FY",
      "op": "financialYearOf",
      "input": {
        "date": "2026-11-30",
        "fyStartMonth": 12
      },
      "expected": {
        "result": {
          "startYear": 2025,
          "label": "2025-26",
          "shortLabel": "25-26",
          "startDate": "2025-12-01",
          "endDate": "2026-11-30"
        }
      }
    },
    {
      "name": "century short label",
      "op": "financialYearOf",
      "input": {
        "date": "2099-06-15",
        "fyStartMonth": 4
      },
      "expected": {
        "result": {
          "startYear": 2099,
          "label": "2099-00",
          "shortLabel": "99-00",
          "startDate": "2099-04-01",
          "endDate": "2100-03-31"
        }
      }
    },
    {
      "name": "timestamp is not a calendar date",
      "op": "financialYearOf",
      "input": {
        "date": "2026-04-01T00:00:00Z",
        "fyStartMonth": 4
      },
      "expected": {
        "error": {
          "code": "VALIDATION_FAILED",
          "message": "A document date must be YYYY-MM-DD."
        }
      }
    },
    {
      "name": "month 13 is rejected",
      "op": "financialYearOf",
      "input": {
        "date": "2026-04-01",
        "fyStartMonth": 13
      },
      "expected": {
        "error": {
          "code": "VALIDATION_FAILED",
          "message": "Financial year start month must be 1-12."
        }
      }
    },
    {
      "name": "short FY label in the number",
      "op": "formatDocumentNumber",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": true,
          "padding": 5,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "sequenceNo": 42,
        "maxLength": 16
      },
      "expected": {
        "result": "INV/26-27/00042"
      }
    },
    {
      "name": "per-counter series without the year",
      "op": "formatDocumentNumber",
      "input": {
        "format": {
          "prefix": "IN",
          "outletCode": "M1",
          "counterCode": "C1",
          "includeFinancialYear": false,
          "padding": 3,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "sequenceNo": 7,
        "maxLength": 16
      },
      "expected": {
        "result": "IN/M1/C1/007"
      }
    },
    {
      "name": "sequence wider than padding",
      "op": "formatDocumentNumber",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": true,
          "padding": 5,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "sequenceNo": 999999,
        "maxLength": 16
      },
      "expected": {
        "result": "INV/26-27/999999"
      }
    },
    {
      "name": "sequence overflowing the limit",
      "op": "formatDocumentNumber",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": true,
          "padding": 5,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "sequenceNo": 1000000,
        "maxLength": 16
      },
      "expected": {
        "error": {
          "code": "VALIDATION_FAILED",
          "message": "Document number \"INV/26-27/1000000\" exceeds 16 characters."
        }
      }
    },
    {
      "name": "illegal separator",
      "op": "formatDocumentNumber",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": true,
          "padding": 5,
          "separator": "#"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "sequenceNo": 1,
        "maxLength": 16
      },
      "expected": {
        "error": {
          "code": "VALIDATION_FAILED",
          "message": "Document number \"INV#26-27#00001\" contains characters GST does not permit."
        }
      }
    },
    {
      "name": "zero sequence",
      "op": "formatDocumentNumber",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": true,
          "padding": 5,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "sequenceNo": 0,
        "maxLength": 16
      },
      "expected": {
        "error": {
          "code": "VALIDATION_FAILED",
          "message": "A document sequence number must be a positive integer."
        }
      }
    },
    {
      "name": "hyphen separator with outlet code",
      "op": "formatDocumentNumber",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": true,
          "padding": 5,
          "separator": "-",
          "outletCode": "PUNE"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "sequenceNo": 15,
        "maxLength": 16
      },
      "expected": {
        "error": {
          "code": "VALIDATION_FAILED",
          "message": "Document number \"INV-PUNE-26-27-00015\" exceeds 16 characters."
        }
      }
    },
    {
      "name": "ceiling of the default format",
      "op": "maxSequenceFor",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": true,
          "padding": 5,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "maxLength": 16
      },
      "expected": {
        "result": 999999
      }
    },
    {
      "name": "ceiling of a per-counter format",
      "op": "maxSequenceFor",
      "input": {
        "format": {
          "prefix": "IN",
          "outletCode": "M1",
          "counterCode": "C1",
          "includeFinancialYear": false,
          "padding": 3,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "maxLength": 16
      },
      "expected": {
        "result": 9999999
      }
    },
    {
      "name": "ceiling with no room",
      "op": "maxSequenceFor",
      "input": {
        "format": {
          "prefix": "INVOICE-LONG",
          "includeFinancialYear": true,
          "padding": 5,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "maxLength": 16
      },
      "expected": {
        "result": 0
      }
    },
    {
      "name": "valid format",
      "op": "validateSeriesFormat",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": true,
          "padding": 5,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "rules": {
          "maxLength": 16,
          "minSequenceHeadroom": 99999
        }
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "valid per-counter format",
      "op": "validateSeriesFormat",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": false,
          "padding": 5,
          "separator": "/",
          "counterCode": "C1"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "rules": {
          "maxLength": 16,
          "minSequenceHeadroom": 99999
        }
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "format overflowing mid-year",
      "op": "validateSeriesFormat",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": true,
          "padding": 5,
          "separator": "/",
          "counterCode": "C1"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "rules": {
          "maxLength": 16,
          "minSequenceHeadroom": 99999
        }
      },
      "expected": {
        "error": {
          "code": "VALIDATION_FAILED",
          "message": "This format can only number up to 999 documents within 16 characters. Shorten the prefix or codes, or drop the financial-year segment (the invoice date already implies it)."
        }
      }
    },
    {
      "name": "padding wider than the room",
      "op": "validateSeriesFormat",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": true,
          "padding": 9,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "rules": {
          "maxLength": 16,
          "minSequenceHeadroom": 99999
        }
      },
      "expected": {
        "error": {
          "code": "VALIDATION_FAILED",
          "message": "Padding of 9 does not fit; there is room for 6 digits."
        }
      }
    },
    {
      "name": "prefix with illegal characters",
      "op": "validateSeriesFormat",
      "input": {
        "format": {
          "prefix": "IN V",
          "includeFinancialYear": true,
          "padding": 5,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "rules": {
          "maxLength": 16,
          "minSequenceHeadroom": 99999
        }
      },
      "expected": {
        "error": {
          "code": "VALIDATION_FAILED",
          "message": "A series prefix may contain only letters, digits and hyphens."
        }
      }
    },
    {
      "name": "zero padding",
      "op": "validateSeriesFormat",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": true,
          "padding": 0,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "rules": {
          "maxLength": 16,
          "minSequenceHeadroom": 99999
        }
      },
      "expected": {
        "error": {
          "code": "VALIDATION_FAILED",
          "message": "Sequence padding must be a positive integer."
        }
      }
    },
    {
      "name": "stricter headroom rule",
      "op": "validateSeriesFormat",
      "input": {
        "format": {
          "prefix": "INV",
          "includeFinancialYear": true,
          "padding": 5,
          "separator": "/"
        },
        "fy": {
          "date": "2026-06-15",
          "fyStartMonth": 4
        },
        "rules": {
          "maxLength": 16,
          "minSequenceHeadroom": 10000000
        }
      },
      "expected": {
        "error": {
          "code": "VALIDATION_FAILED",
          "message": "This format can only number up to 999999 documents within 16 characters. Shorten the prefix or codes, or drop the financial-year segment (the invoice date already implies it)."
        }
      }
    },
    {
      "name": "remaining in a fresh block",
      "op": "remainingInBlock",
      "input": {
        "block": {
          "startSeq": 101,
          "endSeq": 150,
          "consumedUpTo": null,
          "expiresAt": "2026-12-31T00:00:00.000Z"
        }
      },
      "expected": {
        "result": 50
      }
    },
    {
      "name": "remaining after consumption",
      "op": "remainingInBlock",
      "input": {
        "block": {
          "startSeq": 101,
          "endSeq": 150,
          "consumedUpTo": 120,
          "expiresAt": "2026-12-31T00:00:00.000Z"
        }
      },
      "expected": {
        "result": 30
      }
    },
    {
      "name": "remaining when spent",
      "op": "remainingInBlock",
      "input": {
        "block": {
          "startSeq": 101,
          "endSeq": 150,
          "consumedUpTo": 150,
          "expiresAt": "2026-12-31T00:00:00.000Z"
        }
      },
      "expected": {
        "result": 0
      }
    },
    {
      "name": "next in a fresh block",
      "op": "nextInBlock",
      "input": {
        "block": {
          "startSeq": 101,
          "endSeq": 150,
          "consumedUpTo": null,
          "expiresAt": "2026-12-31T00:00:00.000Z"
        },
        "now": "2026-06-15T10:00:00.000Z"
      },
      "expected": {
        "result": 101
      }
    },
    {
      "name": "next after consumption",
      "op": "nextInBlock",
      "input": {
        "block": {
          "startSeq": 101,
          "endSeq": 150,
          "consumedUpTo": 120,
          "expiresAt": "2026-12-31T00:00:00.000Z"
        },
        "now": "2026-06-15T10:00:00.000Z"
      },
      "expected": {
        "result": 121
      }
    },
    {
      "name": "next when spent",
      "op": "nextInBlock",
      "input": {
        "block": {
          "startSeq": 101,
          "endSeq": 150,
          "consumedUpTo": 150,
          "expiresAt": "2026-12-31T00:00:00.000Z"
        },
        "now": "2026-06-15T10:00:00.000Z"
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "next when expired",
      "op": "nextInBlock",
      "input": {
        "block": {
          "startSeq": 101,
          "endSeq": 150,
          "consumedUpTo": null,
          "expiresAt": "2026-06-01T00:00:00.000Z"
        },
        "now": "2026-06-15T10:00:00.000Z"
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "next at the exact expiry instant",
      "op": "nextInBlock",
      "input": {
        "block": {
          "startSeq": 101,
          "endSeq": 150,
          "consumedUpTo": null,
          "expiresAt": "2026-06-15T10:00:00.000Z"
        },
        "now": "2026-06-15T10:00:00.000Z"
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "exhausted when expired",
      "op": "isBlockExhausted",
      "input": {
        "block": {
          "startSeq": 101,
          "endSeq": 150,
          "consumedUpTo": null,
          "expiresAt": "2026-06-01T00:00:00.000Z"
        },
        "now": "2026-06-15T10:00:00.000Z"
      },
      "expected": {
        "result": true
      }
    },
    {
      "name": "not exhausted while live",
      "op": "isBlockExhausted",
      "input": {
        "block": {
          "startSeq": 101,
          "endSeq": 150,
          "consumedUpTo": 149,
          "expiresAt": "2026-12-31T00:00:00.000Z"
        },
        "now": "2026-06-15T10:00:00.000Z"
      },
      "expected": {
        "result": false
      }
    },
    {
      "name": "expired tails reported, live block ignored",
      "op": "unusedTails",
      "input": {
        "blocks": [
          {
            "startSeq": 101,
            "endSeq": 150,
            "consumedUpTo": 130,
            "expiresAt": "2026-06-01T00:00:00.000Z"
          },
          {
            "startSeq": 151,
            "endSeq": 200,
            "consumedUpTo": null,
            "expiresAt": "2026-06-01T00:00:00.000Z"
          },
          {
            "startSeq": 201,
            "endSeq": 250,
            "consumedUpTo": 210,
            "expiresAt": "2026-12-31T00:00:00.000Z"
          }
        ],
        "now": "2026-06-15T10:00:00.000Z"
      },
      "expected": {
        "result": [
          {
            "from": 131,
            "to": 150
          },
          {
            "from": 151,
            "to": 200
          }
        ]
      }
    },
    {
      "name": "fully consumed expired block has no tail",
      "op": "unusedTails",
      "input": {
        "blocks": [
          {
            "startSeq": 101,
            "endSeq": 150,
            "consumedUpTo": 150,
            "expiresAt": "2026-06-01T00:00:00.000Z"
          }
        ],
        "now": "2026-06-15T10:00:00.000Z"
      },
      "expected": {
        "result": []
      }
    },
    {
      "name": "tails are sorted by start",
      "op": "unusedTails",
      "input": {
        "blocks": [
          {
            "startSeq": 301,
            "endSeq": 350,
            "consumedUpTo": null,
            "expiresAt": "2026-06-01T00:00:00.000Z"
          },
          {
            "startSeq": 101,
            "endSeq": 150,
            "consumedUpTo": 140,
            "expiresAt": "2026-06-01T00:00:00.000Z"
          }
        ],
        "now": "2026-06-15T10:00:00.000Z"
      },
      "expected": {
        "result": [
          {
            "from": 141,
            "to": 150
          },
          {
            "from": 301,
            "to": 350
          }
        ]
      }
    },
    {
      "name": "merge adjacent and overlapping ranges",
      "op": "mergeRanges",
      "input": {
        "ranges": [
          {
            "from": 151,
            "to": 200
          },
          {
            "from": 101,
            "to": 150
          },
          {
            "from": 300,
            "to": 310
          }
        ]
      },
      "expected": {
        "result": [
          {
            "from": 101,
            "to": 200
          },
          {
            "from": 300,
            "to": 310
          }
        ]
      }
    },
    {
      "name": "merge contained range",
      "op": "mergeRanges",
      "input": {
        "ranges": [
          {
            "from": 1,
            "to": 100
          },
          {
            "from": 10,
            "to": 20
          }
        ]
      },
      "expected": {
        "result": [
          {
            "from": 1,
            "to": 100
          }
        ]
      }
    },
    {
      "name": "merge empty",
      "op": "mergeRanges",
      "input": {
        "ranges": []
      },
      "expected": {
        "result": []
      }
    }
  ]
}
