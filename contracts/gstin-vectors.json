{
  "contract": "gstin",
  "version": 1,
  "notes": [
    "Generated by `npm run contracts:generate` from src/domain/gst/gstin.ts; do not edit by hand.",
    "gstinProblem returns null for a valid GSTIN, else \"format\" | \"state_code\" | \"checksum\" (checked in that order).",
    "The SQL function app.gstin_valid() must agree: valid exactly when gstinProblem is null.",
    "The validator does not normalise; normaliseGstin is a separate operation."
  ],
  "cases": [
    {
      "name": "a published valid GSTIN (Maharashtra)",
      "op": "gstinProblem",
      "input": {
        "value": "27AAPFU0939F1ZV"
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "a published valid GSTIN (Karnataka)",
      "op": "gstinProblem",
      "input": {
        "value": "29AAGCB7383J1Z4"
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "a published valid GSTIN (Tamil Nadu)",
      "op": "gstinProblem",
      "input": {
        "value": "33AAACH7409R1Z8"
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "wrong check character",
      "op": "gstinProblem",
      "input": {
        "value": "27AAPFU0939F1ZW"
      },
      "expected": {
        "result": "checksum"
      }
    },
    {
      "name": "lower case is not normalised by the validator",
      "op": "gstinProblem",
      "input": {
        "value": "27aapfu0939f1zv"
      },
      "expected": {
        "result": "format"
      }
    },
    {
      "name": "fourteen characters",
      "op": "gstinProblem",
      "input": {
        "value": "27AAPFU0939F1Z"
      },
      "expected": {
        "result": "format"
      }
    },
    {
      "name": "sixteen characters",
      "op": "gstinProblem",
      "input": {
        "value": "27AAPFU0939F1ZVV"
      },
      "expected": {
        "result": "format"
      }
    },
    {
      "name": "14th character must be Z",
      "op": "gstinProblem",
      "input": {
        "value": "27AAPFU0939F1AV"
      },
      "expected": {
        "result": "format"
      }
    },
    {
      "name": "13th character may not be 0",
      "op": "gstinProblem",
      "input": {
        "value": "27AAPFU0939F0ZW"
      },
      "expected": {
        "result": "format"
      }
    },
    {
      "name": "state code 00",
      "op": "gstinProblem",
      "input": {
        "value": "00AAPFU0939F1ZB"
      },
      "expected": {
        "result": "state_code"
      }
    },
    {
      "name": "state code 39 is not a GST state",
      "op": "gstinProblem",
      "input": {
        "value": "39AAPFU0939F1ZQ"
      },
      "expected": {
        "result": "state_code"
      }
    },
    {
      "name": "state code 96 is a place of supply, not a registration",
      "op": "gstinProblem",
      "input": {
        "value": "96AAPFU0939F1ZQ"
      },
      "expected": {
        "result": "state_code"
      }
    },
    {
      "name": "state code 97 (Other Territory)",
