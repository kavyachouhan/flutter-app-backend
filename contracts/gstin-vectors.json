        "value": "0717UNO00157UN"
      },
      "expected": {
        "result": false
      }
    },
    {
      "name": "normalise strips spaces and upper-cases",
      "op": "normaliseGstin",
      "input": {
        "value": " 27aapfu 0939f1zv "
      },
      "expected": {
        "result": "27AAPFU0939F1ZV"
      }
    },
    {
      "name": "prefix matches declared state",
      "op": "gstinMatchesState",
      "input": {
        "value": "27AAPFU0939F1ZV",
        "stateCode": "27"
      },
      "expected": {
        "result": true
      }
    },
