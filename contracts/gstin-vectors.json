      "input": {
        "value": "28AAPFU0939F1ZT"
      },
      "expected": {
        "result": null
      }
    },
    {
      "name": "PAN digits where letters belong",
      "op": "gstinProblem",
      "input": {
        "value": "2712345678901ZV"
      },
      "expected": {
        "result": "format"
      }
    },
    {
      "name": "empty string",
      "op": "gstinProblem",
      "input": {
        "value": ""
      },
      "expected": {
        "result": "format"
      }
    },
    {
      "name": "UIN: fifteen upper-case alphanumerics",
